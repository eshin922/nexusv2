{
  "name": "nexusv2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "cure": "node scripts/cure.mjs",
    "verify:types": "tsc -p tsconfig.json --noEmit",
    "verify:gate-1b-types": "tsc -p tsconfig.gate-1b-scripts.json --noEmit",
    "verify:netsuite-isolation": "node --experimental-strip-types scripts/verify/netsuite-presentation-isolation.ts",
    "verify:boundaries": "node --experimental-strip-types scripts/verify/customer-view-boundary.ts",
    "verify:react-pdf-containment": "node --experimental-strip-types scripts/verify/react-pdf-containment.ts",
    "verify:font-register-coverage": "node --experimental-strip-types scripts/verify/font-register-coverage.ts",
    "verify:autosave-focus-stability": "node --experimental-strip-types scripts/verify/autosave-focus-stability.ts",
    "verify:governed-action-failure": "node --experimental-strip-types scripts/verify/governed-action-failure-contract.ts",
    "verify:complete-status-writer": "node --experimental-strip-types scripts/verify/complete-status-writer.ts",
    "verify:audit-single-writer": "node --experimental-strip-types scripts/verify/audit-single-writer.ts",
    "gate1b:capture-baseline": "node --env-file=.env.local --experimental-strip-types --conditions=react-server --experimental-loader ./scripts/support/src-resolver.mjs scripts/gate-1b/capture-costing-baseline.ts",
    "gate1b:resolver-smoke": "node --env-file=.env.local --experimental-strip-types --conditions=react-server --experimental-loader ./scripts/support/src-resolver.mjs scripts/gate-1b/resolver-smoke.ts",
    "gate1b:verify-preserved": "node --env-file=.env.local --experimental-strip-types --conditions=react-server --experimental-loader ./scripts/support/src-resolver.mjs scripts/gate-1b/verify-costing-preserved.ts",
    "gate1b:add-user-falsification": "node --env-file=.env.local --experimental-strip-types --conditions=react-server --experimental-loader ./scripts/support/src-resolver.mjs scripts/gate-1b/add-user-refusal-falsification.ts",
    "gate1b:recovery-impact-certify": "node --env-file=.env.local --experimental-strip-types --conditions=react-server --experimental-loader ./scripts/support/src-resolver.mjs scripts/gate-1b/recovery-impact-certify.ts",
    "gate1b:recovery-walk-state": "node --env-file=.env.local --experimental-strip-types --conditions=react-server --experimental-loader ./scripts/support/src-resolver.mjs scripts/gate-1b/recovery-walk-state.ts",
    "gate1b:send-freeze-verify": "node --env-file=.env.local --experimental-strip-types --conditions=react-server --experimental-loader ./scripts/support/src-resolver.mjs scripts/gate-1b/send-freeze-verify.ts",
    "gate1b:frozen-instruction-contrast": "node --env-file=.env.local --experimental-strip-types --conditions=react-server --experimental-loader ./scripts/support/src-resolver.mjs scripts/gate-1b/frozen-instruction-contrast.ts",
    "gate1b:recovery-persistence-walk": "node --env-file=.env.local --experimental-strip-types --conditions=react-server --experimental-loader ./scripts/support/src-resolver.mjs scripts/gate-1b/recovery-persistence-walk.ts",
    "gate1b:frozen-instruction-certify": "node --env-file=.env.local --experimental-strip-types --conditions=react-server --experimental-loader ./scripts/support/src-resolver.mjs scripts/gate-1b/frozen-instruction-certify.ts",
    "gate1b:basket-membership": "node --env-file=.env.local --experimental-strip-types --conditions=react-server --experimental-loader ./scripts/support/src-resolver.mjs scripts/gate-1b/basket-membership-check.ts",
    "verify:od-023": "cross-env NODE_OPTIONS=\"--require=./scripts/smoke/shim-server-only.cjs --require=./scripts/smoke/shim-next-cache.cjs\" TSX_TSCONFIG_PATH=./tsconfig.verify-scripts.json npx tsx --env-file=.env.validation.local scripts/verify/od-023-snapshot-completeness.ts",
    "verify:below-floor-record": "node --env-file=.env.validation.local --experimental-strip-types --conditions=react-server --experimental-loader ./scripts/support/src-resolver.mjs scripts/verify/below-floor-authorization-record.ts",
    "verify:s7-preserved:report": "npm run verify:s7-preserved || echo \"S-7 reported differences — report-only, not a build veto (see docs/gate-1b/)\"",
    "verify:s7-preserved": "node --env-file-if-exists=.env.local --experimental-strip-types --conditions=react-server --experimental-loader ./scripts/support/src-resolver.mjs scripts/gate-1b/verify-costing-preserved.ts",
    "verify:ri-7-readiness": "node --env-file=.env.local --experimental-strip-types scripts/verify/ri-7-schema-readiness.ts",
    "verify:scenario-quote-invariant": "node --env-file=.env.local --experimental-strip-types scripts/verify/scenario-quote-status-invariant.ts",
    "rehearsal:r2": "node --env-file=.env.local --experimental-strip-types --conditions=react-server --experimental-loader ./scripts/support/src-resolver.mjs scripts/rehearsal/r2-identity-parity.ts",
    "verify:pricing-classifier-invariants": "node --experimental-strip-types scripts/verify/pricing-classifier-invariants.ts",
    "verify:product-structure-slice1": "node --env-file=.env.validation.local --experimental-strip-types scripts/product-structure/slice1-preflight.ts",
    "test:netsuite-adapter": "node --experimental-strip-types scripts/test-netsuite-adapter.ts",
    "test:unit": "node --experimental-strip-types --experimental-loader=./tests/support/server-contract-loader.mjs --test tests/unit/*.test.ts",
    "test:e2e": "node --env-file=.env.validation.local node_modules/@playwright/test/cli.js test",
    "test:e2e:headed": "node --env-file=.env.validation.local node_modules/@playwright/test/cli.js test --headed",
    "validation:db": "node --env-file=.env.validation.local --experimental-strip-types scripts/validation/cli.ts",
    "validation:db:start": "npm run validation:db -- start",
    "validation:db:migrate": "npm run validation:db -- migrate",
    "validation:db:reset": "npm run validation:db -- reset",
    "validation:db:teardown": "npm run validation:db -- teardown",
    "validation:prove-isolation": "npm run validation:db -- prove-isolation",
    "validation:fixtures": "node --env-file=.env.validation.local --experimental-strip-types scripts/validation/fixtures.ts",
    "validation:seed": "npm run validation:fixtures -- seed",
    "validation:fixtures:validate": "npm run validation:fixtures -- validate",
    "validation:fixtures:reset": "npm run validation:fixtures -- reset",
    "validation:app": "cross-env NODE_OPTIONS=--max-old-space-size=8192 node --env-file=.env.validation.local node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3100",
    "smoke:netsuite-item-groups": "cross-env NODE_OPTIONS=--require=./scripts/smoke/shim-server-only.cjs npx tsx --env-file=.env.local ./scripts/smoke/netsuite-item-groups.ts",
    "smoke:hubspot-deal-property-expansion": "cross-env NODE_OPTIONS=--require=./scripts/smoke/shim-server-only.cjs npx tsx --env-file=.env.local ./scripts/smoke/hubspot-deal-property-expansion.ts",
    "smoke:mark-complete": "cross-env NODE_OPTIONS=--require=./scripts/smoke/shim-server-only.cjs npx tsx --env-file=.env.local ./scripts/smoke/mark-complete.ts",
    "prebuild": "npm run verify:types && npm run verify:gate-1b-types && npm run verify:boundaries && npm run verify:react-pdf-containment && npm run verify:font-register-coverage && npm run verify:autosave-focus-stability && npm run verify:governed-action-failure && npm run verify:complete-status-writer && npm run verify:audit-single-writer && npm run verify:pricing-classifier-invariants && npm run test:netsuite-adapter && npm run verify:migration-index",
    "verify:ci": "npm run verify:types && npm run verify:gate-1b-types && npm run verify:boundaries && npm run verify:react-pdf-containment && npm run verify:font-register-coverage && npm run verify:autosave-focus-stability && npm run verify:governed-action-failure && npm run verify:complete-status-writer && npm run verify:audit-single-writer && npm run verify:pricing-classifier-invariants && npm run test:netsuite-adapter && npm run verify:migration-index && npm run verify:netsuite-isolation",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "node scripts/verify/schema-drift.mjs",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node -e \"console.error('[OD-012] db:push is blocked. It mutates the shared database with no migration or journal record. Hand-author a migration at (highest index + 1) and run db:migrate.'); process.exit(1)\"",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "verify:migration-index": "node --experimental-strip-types scripts/verify/migration-index-unique.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.12.0",
    "@hubspot/api-client": "^13.5.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.105.1",
    "drizzle-orm": "^0.36.4",
    "next": "^15.1.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.30.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
