{
  "name": "nexusv2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "cure": "node scripts/cure.mjs",
    "verify:boundaries": "node --experimental-strip-types scripts/verify/customer-view-boundary.ts",
    "verify:react-pdf-containment": "node --experimental-strip-types scripts/verify/react-pdf-containment.ts",
    "verify:font-register-coverage": "node --experimental-strip-types scripts/verify/font-register-coverage.ts",
    "verify:autosave-focus-stability": "node --experimental-strip-types scripts/verify/autosave-focus-stability.ts",
    "verify:complete-status-writer": "node --experimental-strip-types scripts/verify/complete-status-writer.ts",
    "verify:ri-7-readiness": "node --env-file=.env.local --experimental-strip-types scripts/verify/ri-7-schema-readiness.ts",
    "verify:scenario-quote-invariant": "node --env-file=.env.local --experimental-strip-types scripts/verify/scenario-quote-status-invariant.ts",
    "verify:pricing-classifier-invariants": "node --experimental-strip-types scripts/verify/pricing-classifier-invariants.ts",
    "prebuild": "npm run verify:boundaries && npm run verify:react-pdf-containment && npm run verify:font-register-coverage && npm run verify:autosave-focus-stability && npm run verify:complete-status-writer && npm run verify:pricing-classifier-invariants",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.12.0",
    "@hubspot/api-client": "^13.5.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.105.1",
    "drizzle-orm": "^0.36.4",
    "next": "^15.1.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.30.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
