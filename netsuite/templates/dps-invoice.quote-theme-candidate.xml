<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
        <link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}"
            src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}"
            src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
        <#if .locale=="zh_CN">
            <link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}"
                src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
            <#elseif .locale=="zh_TW">
                <link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}"
                    src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
                <#elseif .locale=="ja_JP">
                    <link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}"
                        src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
                    <#elseif .locale=="ko_KR">
                        <link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}"
                            src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
                        <#elseif .locale=="th_TH">
                            <link name="NotoSansThai" type="font" subtype="opentype"
                                src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
        </#if>
        <macrolist>
            <macro id="nlheader">
                <table class="nx-masthead" style="width:100%; border-bottom:1.1pt solid #131921;"><tr>
                    <td width="56%" valign="top"><#if subsidiary.logo?length !=0><img src="${subsidiary.logo@url}" style="width:50pt; height:50pt;" /></#if></td>
                    <td width="44%" align="right" valign="top"><p style="margin:0 0 5pt 0; line-height:18pt; font-family:NotoSans,sans-serif; font-size:14pt; font-weight:bold; color:#131921;">INVOICE</p><p class="nx-po-number" style="margin:0 0 6pt 0; line-height:15pt;">${record.tranid}</p><p class="nx-meta" style="margin:0 0 3pt 0; line-height:11pt;">ISSUED · ${record.trandate}</p><p class="nx-meta" style="margin:0; line-height:11pt;">DUE · ${record.duedate}</p></td>
                </tr></table>
            </macro>
            <macro id="nlfooter"><table class="nx-footer" style="width:100%; border-top:0.75pt solid #d3d1ca;"><tr>
                <td align="left" width="75%">THE DPS · INVOICE ${record.tranid}</td>
                <td align="right" width="25%">PAGE <pagenumber /> OF <totalpages /></td>
            </tr></table></macro>
        </macrolist>
        <style type="text/css">
            * {
                <#if .locale=="zh_CN">font-family: NotoSans, NotoSansCJKsc, sans-serif;
                <#elseif .locale=="zh_TW">font-family: NotoSans, NotoSansCJKtc, sans-serif;
                <#elseif .locale=="ja_JP">font-family: NotoSans, NotoSansCJKjp, sans-serif;
                <#elseif .locale=="ko_KR">font-family: NotoSans, NotoSansCJKkr, sans-serif;
                <#elseif .locale=="th_TH">font-family: NotoSans, NotoSansThai, sans-serif;
                <#else>font-family: NotoSans, sans-serif;
                </#if>
            }

            table.details td {
                border: none
            }

            table {
                font-size: 9pt;
                table-layout: fixed;
            }

            th {
                font-weight: bold;
                font-size: 8pt;
                vertical-align: middle;
                padding: 5px 6px 3px;
                background-color: #e3e3e3;
                color: #333333;
            }

            td {
                padding: 4px 6px;
            }

            td p {
                align: left
            }

            b {
                font-weight: bold;
                color: #333333;
            }

            table.header td {
                padding: 0;
                font-size: 10pt;
            }

            table.footer td {
                padding: 0;
                font-size: 8pt;
            }

            table.itemtable th {
                padding-bottom: 10px;
                padding-top: 10px;
            }

            table.body td {}

            table.detail td {
                border-top: 1px solid;
                border-right: 1px solid;
                border-left: 1px solid;
            }

            table.total {
                page-break-inside: avoid;
            }

            tr.totalrow {
                background-color: #e3e3e3;
                line-height: 200%;
            }

            td.totalboxtop {
                font-size: 12pt;
                background-color: #e3e3e3;
            }

            td.addressheader {
                font-size: 8pt;
                padding-top: 6px;
                padding-bottom: 2px;
            }

            td.address {
                padding-top: 0;
            }

            td.totalboxmid {
                font-size: 28pt;
                padding-top: 20px;
                background-color: #e3e3e3;
            }

            td.totalboxbot {
                background-color: #e3e3e3;
                font-weight: bold;
            }

            span.title {
                font-size: 23pt;
            }

            span.number {
                font-size: 18pt;
            }

            span.itemname {
                font-weight: bold;
                line-height: 150%;
            }

            hr {
                width: 100%;
                color: #d3d3d3;
                background-color: #d3d3d3;
                height: 1px;
            }
            body { color:#131921; background-color:#fefdfc; font-family:NotoSans,sans-serif; }
            .nx-masthead td { padding:0 0 11pt 0; border:none; }
            .nx-brand { font-family:Times,serif; font-size:20.25pt; color:#131921; }
            .nx-subbrand { font-family:Times,serif; font-size:9pt; color:#646971; }
            .nx-po-number { font-family:Courier,monospace; font-size:12pt; color:#131921; }
            .nx-meta { font-family:Courier,monospace; font-size:7.5pt; color:#646971; line-height:1.8; }
            .nx-parties { width:100%; margin-top:14pt; }
            .nx-parties td { width:50%; vertical-align:top; padding:0 16pt 0 0; border:none; }
            .nx-parties p { margin:0 0 3pt 0; line-height:11pt; }
            .nx-label { font-family:Courier,monospace; font-size:6.75pt; color:#7b8187; letter-spacing:0.7pt; }
            .nx-party-name { font-family:Times,serif; font-size:12pt; color:#131921; }
            .nx-party-line { font-family:Times,serif; font-size:9pt; color:#383e46; line-height:1.45; }
            .nx-facts { width:100%; margin-top:13pt; border-top:0.75pt solid #d3d1ca; border-bottom:0.75pt solid #d3d1ca; }
            .nx-facts td { padding:7pt 8pt 7pt 0; vertical-align:top; border:none; }
            .nx-fact-value { font-family:Times,serif; font-size:8.5pt; color:#383e46; }
            .nx-items { width:100%; margin-top:17pt; table-layout:fixed; }
            .nx-items th { font-family:Courier,monospace; font-size:7pt; font-weight:normal; color:#646971; background-color:#fefdfc; border-bottom:1.1pt solid #131921; padding:0 5pt 6pt 0; }
            .nx-items td { padding:9pt 5pt 8pt 0; border-bottom:0.75pt solid #d3d1ca; vertical-align:top; }
            .nx-item-name { font-family:Times,serif; font-size:10.5pt; color:#131921; }
            .nx-item-sku { font-family:Courier,monospace; font-size:6.75pt; color:#7b8187; }
            .nx-item-desc { font-family:Times,serif; font-size:8pt; color:#646971; }
            .nx-num { font-family:Courier,monospace; font-size:9pt; color:#131921; }
            .nx-spec td { padding:2pt 6pt 8pt 8pt; border-bottom:0.75pt solid #d3d1ca; color:#646971; font-size:7.5pt; }
            .nx-spec-body { border-left:0.75pt solid #d3d1ca; padding-left:7pt; }
            .nx-total td { padding-top:9pt; border-top:1.1pt solid #131921; border-bottom:none; }
            .nx-total-label { font-family:Times,serif; font-size:12pt; color:#131921; }
            .nx-total-value { font-family:Courier,monospace; font-size:11pt; color:#131921; }
            .nx-legacy-title { font-family:Courier,monospace; font-size:7pt; color:#7b8187; letter-spacing:0.7pt; margin-top:22pt; }
            .nx-legacy { width:100%; }
            .nx-legacy td { border-bottom:0.75pt solid #d3d1ca; border-top:none; border-left:none; border-right:none; font-size:8pt; }
            .nx-legacy tr:first-child { display:none; }
            .nx-legal-title { font-family:Times,serif; font-size:13.5pt; color:#131921; }
            .nx-footer td { padding-top:8pt; font-family:Courier,monospace; font-size:6.5pt; color:#7b8187; }
        </style>
    <style type="text/css">.nx-invoice-legal { margin-top:18pt; border-top:0.75pt solid #d3d1ca; padding-top:9pt; font-family:Times,serif; font-size:7.5pt; color:#646971; line-height:1.45; } .nx-invoice-summary { page-break-inside:avoid; } .nx-invoice-summary td { padding:5pt 0; border:none; } .nx-invoice-summary .nx-total td { border-top:1.1pt solid #131921; } </style></head>
<body header="nlheader" header-height="12%" footer="nlfooter" footer-height="30pt" padding="42pt 48pt 48pt 48pt" size="Letter">
<table class="nx-parties"><tr><td><p class="nx-label">BILL TO</p><p class="nx-party-name">${record.entity}</p><p class="nx-party-line">${record.billaddress}</p></td><td><p class="nx-label">FROM</p><p class="nx-party-name">The DPS</p><p class="nx-party-line"><#if subsidiary.mainaddress_text?has_content>${subsidiary.mainaddress_text}<#else>${companyInformation.addressText}</#if></p><p class="nx-party-line"><#if subsidiary.email?has_content>${subsidiary.email}<#else>${companyInformation.adminemail}</#if></p></td></tr></table>
<table class="nx-facts"><tr><td width="25%"><span class="nx-label">CUSTOMER PO</span><br /><span class="nx-fact-value">${record.otherrefnum}</span></td><td width="25%"><span class="nx-label">PAYMENT TERMS</span><br /><span class="nx-fact-value">${record.terms}</span></td><td width="25%"><span class="nx-label">DUE DATE</span><br /><span class="nx-fact-value">${record.duedate}</span></td><td width="25%"><span class="nx-label">SALES REP</span><br /><span class="nx-fact-value">${record.salesrep}</span></td></tr></table>
<#if record.item?has_content>
<#if record.custpage_item_quantity_map?has_content><#assign item_quantity_map=record.custpage_item_quantity_map?eval></#if>
<#assign items=record.item?filter(i -> i.custcol_dps_hubspot_line?has_content)?sort_by("custcol_dps_hubspot_line") + record.item?filter(i -> !i.custcol_dps_hubspot_line?has_content)>
<table class="nx-items"><thead><tr><th width="53%" align="left">ITEM</th><th width="15%" align="right">QUANTITY</th><th width="16%" align="right">RATE</th><th width="16%" align="right">AMOUNT</th></tr></thead>
<#list items as item><#if item.item != 'Special Freight Charge' && !['OTC-0036']?seq_contains(item.custcol_dps_sku)>
<#assign itemQuantity=item.quantity><#if itemQuantity == 0 && item_quantity_map?has_content><#assign itemQuantity=item_quantity_map[item.id]></#if>
<tr><td width="53%"><span class="nx-item-name">${item.item}</span><#if item.custcol_dps_sku?has_content><br /><span class="nx-item-sku">${item.custcol_dps_sku}</span></#if><#if record.custbody_dps_print_with_description && item.description?has_content><br /><span class="nx-item-desc">${item.description}</span></#if></td><td width="15%" align="right"><span class="nx-num">${itemQuantity}</span></td><td width="16%" align="right"><span class="nx-num"><#if item.rate?has_content>${item.rate}<#elseif itemQuantity == 0>0<#else>${(item.amount / itemQuantity)?string["0.####"]}</#if></span></td><td width="16%" align="right"><span class="nx-num">${item.amount}</span></td></tr>
</#if></#list></table></#if>
<table class="nx-invoice-summary" style="width:100%; margin-top:12pt;"><tr><td width="72%"></td><td width="14%" align="right">Subtotal</td><td width="14%" align="right" class="nx-num">${record.subtotal}</td></tr><tr><td></td><td align="right">Tax</td><td align="right" class="nx-num">${record.taxtotal}</td></tr><#if record.shippingcost?has_content><tr><td></td><td align="right">Shipping</td><td align="right" class="nx-num">${record.shippingcost}</td></tr></#if><tr class="nx-total"><td></td><td align="right"><span class="nx-total-label">Total</span></td><td align="right"><span class="nx-total-value">${record.total}</span></td></tr><tr><td></td><td align="right">Paid</td><td align="right" class="nx-num">${record.amountpaid}</td></tr><tr><td></td><td align="right">Balance due</td><td align="right" class="nx-num">${record.amountremaining}</td></tr></table>
<div class="nx-invoice-legal"><table style="width:100%; margin-top:10px;">
            <tr>
                <td style="line-height:140%; color:#333333;">
                    <p align="justify">
                        <b>Past Due Accounts.</b> Invoices not paid within thirty (30) days of the invoice date shall be deemed delinquent and may accrue a finance charge of <b>1.8% per month (21.6% annually)</b> or the <b>maximum rate permitted under applicable California law,</b> whichever is less. Seller reserves the right to <b>suspend or terminate services, production, shipments, or deliveries </b> on any delinquent account. Seller may also, at its option, <b>require prepayment or payment upon delivery</b> for any future orders. Customer agrees to be responsible for <b>all reasonable costs of collection,</b> including but not limited to collection agency fees, court costs, and reasonable attorneys’ fees, incurred by Seller in enforcing payment. </p>
                </td>
            </tr>
        </table></div>
</body>
</pdf>