# Safe isolated validation configuration. Contains no real credentials.
NODE_ENV=test
NEXUS_ISOLATED_TEST=1

DATABASE_URL=postgresql://nexus_validation:nexus_validation@127.0.0.1:55432/nexus_validation_test
DIRECT_URL=postgresql://nexus_validation:nexus_validation@127.0.0.1:55432/nexus_validation_test

NEXUS_AUTH_PROVIDER=isolated
NEXUS_VALIDATION_IDENTITY=pm
NEXUS_HUBSPOT_PROVIDER=isolated
NEXUS_NETSUITE_PROVIDER=isolated
NEXUS_ARTIFACT_PROVIDER=isolated
NEXUS_REALTIME_PROVIDER=isolated

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
NEXUS_VALIDATION_RUN_ID=local-example
NEXUS_VALIDATION_ARTIFACT_DIR=.artifacts/validation/local-example
NEXUS_VALIDATION_ARTIFACT_ROOT=.artifacts/validation/local-example/artifacts
NEXUS_VALIDATION_ARTIFACT_ORIGIN=http://127.0.0.1:3100/api/validation-artifacts
NEXUS_FAKE_HUBSPOT_LEDGER=.artifacts/validation/local-example/fake-hubspot-calls.jsonl
